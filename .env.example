VITE_API_URL=http://localhost:4000/api
VITE_TENANT_ID=replace-with-the-id-printed-by-npm-run-seed
# Production only, once a wildcard custom domain is wired up: the root
# domain tenants are served under (e.g. "tanzhotelier.app"). A visit to
# <slug>.tanzhotelier.app then resolves "slug" as the tenant automatically.
# Leave unset (as on Netlify's shared *.netlify.app domain) to always use
# VITE_TENANT_ID above instead.
# VITE_APP_DOMAIN=tanzhotelier.app
